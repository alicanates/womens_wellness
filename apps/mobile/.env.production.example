# ═══════════════════════════════════════════════════════════════
# 🚀 PRODUCTION ENVIRONMENT VARIABLES (Mobile App)
# ═══════════════════════════════════════════════════════════════
# 
# ⚠️  UYARI: Bu dosya production için template'dir.
# 
# Kullanım:
# 1. Bu dosyayı .env.production olarak kopyalayın
# 2. Tüm PLACEHOLDER değerlerini gerçek değerlerle değiştirin
# 3. .env.production dosyasını ASLA git'e commit ETMEYİN
# 
# 📖 Detaylı rehber: ../../PRODUCTION_ENV_GUIDE.md
# ═══════════════════════════════════════════════════════════════

# ───────────── API Configuration ─────────────
# ⚠️  ZORUNLU: Production API URL
EXPO_PUBLIC_API_BASE_URL=https://api.yourcompany.com

# ───────────── Expo Configuration ─────────────
# Deep linking scheme (app.json ile aynı olmalı!)
EXPO_PUBLIC_SCHEME=wellness
EXPO_PUBLIC_REDIRECT_URL=wellness:/oauthredirect

# ───────────── Google OAuth ─────────────
# ⚠️  ZORUNLU: Google Cloud Console'dan alın
# Rehber: https://console.cloud.google.com/apis/credentials

# iOS Client ID
# Application type: iOS
# Bundle ID: com.yourcompany.wellness (app.json'dan)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=123456789-abc.apps.googleusercontent.com

# Android Client ID
# Application type: Android
# Package name: com.yourcompany.wellness
# SHA-1 fingerprint: EAS Build'den alın (eas credentials -p android)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=123456789-xyz.apps.googleusercontent.com

# Web Client ID (opsiyonel - web preview için)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=123456789-web.apps.googleusercontent.com

# ───────────── EAS Build Configuration ─────────────
# EAS Project ID (opsiyonel - EAS Build kullanıyorsanız)
# Alın: https://expo.dev > Project Settings
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ───────────── Monitoring & Observability ─────────────
# 📊 Şiddetle Önerilir: Production'da mutlaka kullanın!

# Sentry - Error Tracking & Crash Reporting
# 1. https://sentry.io adresinden hesap oluşturun
# 2. Yeni proje oluşturun (React Native)
# 3. DSN'i buraya yapıştırın
# 4. Organization slug ve project name'i girin
SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/7890123
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=wellness-mobile

# PostHog - Product Analytics & Feature Flags
# 1. https://posthog.com adresinden hesap oluşturun
# 2. Project Settings > API Keys
# 3. Project API Key'i buraya yapıştırın
POSTHOG_API_KEY=phc_CHANGE_ME_POSTHOG_KEY
POSTHOG_HOST=https://app.posthog.com

# ───────────── App Configuration ─────────────
# Default locale (tr veya en)
EXPO_PUBLIC_DEFAULT_LOCALE=tr

# Date format (iso, tr, en)
EXPO_PUBLIC_DATE_FORMAT=iso

# ───────────── Feature Flags ─────────────
# Production'da aktif olacak özellikler
EXPO_PUBLIC_FEATURE_GOOGLE_AUTH=true
EXPO_PUBLIC_FEATURE_OFFLINE_FIRST=true
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_FEATURE_IN_APP_PURCHASE=true

# ═══════════════════════════════════════════════════════════════
# ✅ PRODUCTION CHECKLIST (Mobile App)
# ═══════════════════════════════════════════════════════════════
# 
# Deployment öncesi kontrol edin:
# 
# [ ] EXPO_PUBLIC_API_BASE_URL production API'yi gösteriyor
# [ ] EXPO_PUBLIC_SCHEME app.json ile aynı
# [ ] Google OAuth tüm platformlar için yapılandırıldı
# [ ] iOS Client ID doğru bundle ID ile oluşturuldu
# [ ] Android Client ID production SHA-1 fingerprint ile oluşturuldu
# [ ] Sentry DSN yapılandırıldı
# [ ] PostHog API key yapılandırıldı
# [ ] EAS Project ID ayarlandı (EAS Build kullanıyorsanız)
# [ ] Feature flags production için uygun
# [ ] Bu dosya (.env.production) .gitignore'da
# 
# 📖 Detaylı rehber: ../../PRODUCTION_ENV_GUIDE.md
# 📋 Deployment checklist: ../../DEPLOYMENT_CHECKLIST.md
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# 📱 EAS BUILD CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# 
# EAS Build sırasında environment variables nasıl kullanılır:
# 
# 1. .env.production dosyasını oluşturun (bu template'den)
# 2. eas.json'da environment variables'ı referans edin:
# 
#    {
#      "build": {
#        "production": {
#          "env": {
#            "EXPO_PUBLIC_API_BASE_URL": "https://api.yourcompany.com",
#            "SENTRY_DSN": "https://...",
#            "POSTHOG_API_KEY": "phc_..."
#          }
#        }
#      }
#    }
# 
# 3. Veya EAS Secrets kullanın (önerilen):
# 
#    eas secret:create --scope project --name SENTRY_DSN --value "https://..."
#    eas secret:create --scope project --name POSTHOG_API_KEY --value "phc_..."
# 
# 4. Build komutu:
# 
#    eas build --platform ios --profile production
#    eas build --platform android --profile production
# 
# ═══════════════════════════════════════════════════════════════

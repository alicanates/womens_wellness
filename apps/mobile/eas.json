{
    "cli": {
        "version": ">= 13.2.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "node": "20.18.0"
        },
        "demo": {
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://api.kadinatlasi.com"
            },
            "node": "20.18.0"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://api.kadinatlasi.com"
            },
            "node": "20.18.0"
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://api.kadinatlasi.com"
            },
            "node": "20.18.0"
        }
    },
    "submit": {
        "production": {}
    }
}
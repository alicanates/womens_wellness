# ═══════════════════════════════════════════════════════════════
# 🚀 PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
# 
# ⚠️  UYARI: Bu dosya production için template'dir.
# 
# Kullanım:
# 1. Bu dosyayı .env.production olarak kopyalayın
# 2. Tüm PLACEHOLDER değerlerini gerçek API key'leri ile değiştirin
# 3. .env.production dosyasını ASLA git'e commit ETMEYİN
# 
# 📖 Detaylı rehber: ../../PRODUCTION_ENV_GUIDE.md
# ═══════════════════════════════════════════════════════════════

# ───────────── App & Network ─────────────
NODE_ENV=production
PORT=4000

# Production API base URL (örnek: https://api.yourcompany.com)
API_BASE_URL=https://api.yourcompany.com

# Production frontend URL'leri (virgülle ayrılmış)
CORS_ALLOWED_ORIGINS=https://yourcompany.com,https://admin.yourcompany.com

# Log level: warn | error (production'da debug/info kullanmayın!)
LOG_LEVEL=warn

# HTTP timeouts / payload limits
HTTP_REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_MB=25

# ───────────── Database & Cache ─────────────
# ⚠️  ZORUNLU: Production PostgreSQL
# Örnek: postgresql://user:pass@host.com:5432/dbname?sslmode=require
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/wellness?sslmode=require

# ⚠️  ZORUNLU: Production Redis
# Örnek: redis://default:password@host.com:6379
REDIS_URL=redis://default:CHANGE_ME@CHANGE_ME:6379
REDIS_PREFIX=wellness_prod
QUEUE_PREFIX=wellness_prod

# ───────────── Auth / Security ─────────────
# ⚠️  ZORUNLU: JWT secrets (her environment için FARKLI olmalı!)
# Oluştur: openssl rand -hex 32
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ⚠️  ZORUNLU: Admin emails (virgülle ayrılmış)
ADMIN_EMAILS=admin@yourcompany.com,ceo@yourcompany.com

# ⚠️  KRİTİK: Production'da MUTLAKA false!
SKIP_WEBHOOK_VERIFICATION=false

# ⚠️  ZORUNLU: Google Pub/Sub Push Token
# Oluştur: openssl rand -hex 32
# Google Cloud Pub/Sub'da aynı token'ı kullanın
GOOGLE_PUBSUB_PUSH_TOKEN=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Cookies / sessions
COOKIE_SECURE=true
COOKIE_DOMAIN=.yourcompany.com

# ───────────── Google OAuth (OIDC) ─────────────
# ⚠️  ZORUNLU: Google Cloud Console'dan alın
# Rehber: https://console.cloud.google.com/apis/credentials

# iOS Client ID
GOOGLE_OAUTH_CLIENT_ID_IOS=123456789-abc.apps.googleusercontent.com

# Android Client ID (SHA-1 fingerprint ile)
GOOGLE_OAUTH_CLIENT_ID_ANDROID=123456789-xyz.apps.googleusercontent.com

# Web Client ID (Admin panel için)
GOOGLE_OAUTH_CLIENT_ID_WEB=123456789-web.apps.googleusercontent.com

# Tüm client ID'ler (virgülle ayrılmış)
GOOGLE_OAUTH_AUDIENCES=123456789-abc.apps.googleusercontent.com,123456789-xyz.apps.googleusercontent.com,123456789-web.apps.googleusercontent.com

# Domain restriction (opsiyonel)
GOOGLE_OAUTH_ALLOWED_HD=

# Redirect URLs
PUBLIC_MOBILE_SCHEME=wellness
PUBLIC_MOBILE_REDIRECT_URL=wellness:/oauthredirect
PUBLIC_WEB_ORIGIN=https://admin.yourcompany.com

# ───────────── Email (verification / reset) ─────────────
# 📧 Önerilen: SendGrid, AWS SES, veya Mailgun
# SendGrid örneği:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM="Wellness App <noreply@yourcompany.com>"
SMTP_TLS=true

# ───────────── File Storage ─────────────
# 📦 Önerilen: AWS S3
STORAGE_DRIVER=s3

# AWS S3 Configuration
S3_REGION=eu-central-1
S3_BUCKET=wellness-production
S3_ACCESS_KEY_ID=AKIA_CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
S3_FORCE_PATH_STYLE=false
S3_SSE=AES256

# Alternatif: MinIO (self-hosted)
# STORAGE_DRIVER=minio
# MINIO_ENDPOINT=minio.yourcompany.com
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=CHANGE_ME
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_BUCKET=wellness
# MINIO_USE_SSL=true

# ───────────── AI Providers ─────────────
# ⚠️  ZORUNLU: Google Gemini API (chat için gerekli!)
# Alın: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy_CHANGE_ME_GEMINI_API_KEY

# 🔄 Backup AI Providers (şiddetle önerilir!)
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-CHANGE_ME_OPENAI_KEY

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_ANTHROPIC_KEY

# DeepSeek (opsiyonel)
DEEPSEEK_API_KEY=sk-CHANGE_ME_DEEPSEEK_KEY

# ───────────── Push Notifications ─────────────
# ⚠️  ZORUNLU: Expo Access Token
# Alın: https://expo.dev > Account Settings > Access Tokens
EXPO_ACCESS_TOKEN=CHANGE_ME_EXPO_ACCESS_TOKEN

# ───────────── Monitoring & Observability ─────────────
# 📊 Şiddetle Önerilir: Production'da mutlaka kullanın!

# Sentry - Error Tracking & Performance
# Alın: https://sentry.io > Create Project > Node.js
SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/7890123

# PostHog - Product Analytics
# Alın: https://posthog.com > Project Settings > API Keys
POSTHOG_API_KEY=phc_CHANGE_ME_POSTHOG_KEY
POSTHOG_HOST=https://app.posthog.com

# ───────────── In-App Purchase (IAP) ─────────────
# ⚠️  ZORUNLU: Subscription özelliği için gerekli!

# Apple App Store
# Alın: App Store Connect > App > Subscriptions > App-Specific Shared Secret
APPLE_SHARED_SECRET=CHANGE_ME_APPLE_SHARED_SECRET

# Google Play Store
# Alın: Play Console > API Access > Service Account > Create Key (JSON)
# JSON'u tek satıra çevirin: cat key.json | jq -c
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"CHANGE_ME","private_key_id":"CHANGE_ME","private_key":"-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n","client_email":"CHANGE_ME@CHANGE_ME.iam.gserviceaccount.com","client_id":"CHANGE_ME","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"CHANGE_ME"}

# Google Cloud Project ID (webhook validation için)
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# ───────────── Feature Flags ─────────────
FEATURE_GOOGLE_AUTH=true
FEATURE_OFFLINE_FIRST=true

# ───────────── Defaults ─────────────
PAGINATION_DEFAULT_LIMIT=20

# ═══════════════════════════════════════════════════════════════
# ✅ PRODUCTION CHECKLIST
# ═══════════════════════════════════════════════════════════════
# 
# Deployment öncesi kontrol edin:
# 
# [ ] Tüm CHANGE_ME değerleri değiştirildi
# [ ] Tüm GENERATE_WITH_OPENSSL değerleri oluşturuldu
# [ ] DATABASE_URL production instance'ı gösteriyor
# [ ] REDIS_URL production instance'ı gösteriyor
# [ ] JWT_SECRET ve JWT_REFRESH_SECRET farklı ve güçlü
# [ ] SKIP_WEBHOOK_VERIFICATION=false ayarlandı
# [ ] Google OAuth tüm platformlar için yapılandırıldı
# [ ] Gemini API key test edildi
# [ ] Expo access token alındı
# [ ] Apple shared secret alındı
# [ ] Google service account key alındı ve Pub/Sub yapılandırıldı
# [ ] Sentry DSN yapılandırıldı
# [ ] PostHog API key yapılandırıldı
# [ ] SMTP credentials test edildi
# [ ] S3 bucket oluşturuldu ve CORS yapılandırıldı
# [ ] CORS_ALLOWED_ORIGINS production domain'leri içeriyor
# [ ] API_BASE_URL production URL'i
# [ ] NODE_ENV=production
# [ ] LOG_LEVEL=warn veya error
# [ ] Bu dosya (.env.production) .gitignore'da
# 
# 📖 Detaylı rehber: ../../PRODUCTION_ENV_GUIDE.md
# 📋 Deployment checklist: ../../DEPLOYMENT_CHECKLIST.md
# ═══════════════════════════════════════════════════════════════

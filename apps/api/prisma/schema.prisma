// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Production tuning (uncomment for prod):
  // connection_limit = 10
  // connect_timeout = 10
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  google
}

enum HealthMetricKind {
  BMI
  BMR
  WATER
  CUSTOM
}

enum ReminderType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum MessageRole {
  user
  assistant
  tool
}

enum MemoryScope {
  global
  conversation
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum AIProvider {
  openai
  anthropic
  google
}

// ────────────────────────────────────────────────────────────────────────────
// User & Auth
// ────────────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String?    @unique // Lowercase, alphanumeric + . _ (temporary nullable for migration)
  password  String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  profile             Profile?
  oauthAccounts       OAuthAccount[]
  healthMetrics       HealthMetric[]
  periodCycles        PeriodCycle[]
  dailyLogs           DailyLog[]
  pregnancy           Pregnancy?
  waterLogs           WaterLog[]
  reminders           Reminder[]
  conversations       Conversation[]
  memories            Memory[]
  subscription        Subscription?
  usageQuota          UsageQuota?
  auditLogs           AuditLog[]
  homePreferences     UserHomePreferences?
  dailySteps          DailySteps[]
  meditationSessions  MeditationSession[]
  sleepLogs           SleepLog[]
  wellnessPreferences WellnessPreferences?

  @@index([email])
  @@index([username])
}

model Profile {
  id                String    @id @default(cuid())
  userId            String    @unique
  firstName         String?   // Temporary nullable for migration
  lastName          String?   // Temporary nullable for migration
  displayName       String
  dateOfBirth       DateTime? // Full birth date for age calculations
  heightCm          Float?
  weightKg          Float?
  country           String?
  timezone          String    @default("Europe/Istanbul")
  profilePictureUrl String?
  preferencesJson   Json? // Encrypted field
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  email          String
  rawJson        Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ────────────────────────────────────────────────────────────────────────────
// Health & Tracking
// ────────────────────────────────────────────────────────────────────────────

model HealthMetric {
  id         String           @id @default(cuid())
  userId     String
  kind       HealthMetricKind
  valueJson  Json
  measuredAt DateTime         @default(now())
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PeriodCycle {
  id           String    @id @default(cuid())
  userId       String
  startDate    DateTime
  endDate      DateTime?
  symptomsJson Json? // Encrypted field, matches PeriodSymptoms interface
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLogs    DailyLog[]

  @@index([userId, startDate])
}

// Detailed daily logs for symptoms, sex, medications, etc.
model DailyLog {
  id            String       @id @default(cuid())
  userId        String
  cycleId       String?
  date          DateTime

  // Period details
  flow          String? // light, moderate, heavy
  cramps        Int? // 0-5 scale

  // Symptoms & Mood
  symptoms      String[] @default([]) // Array of symptom names
  mood          String[] @default([]) // mood, energy levels

  // Sex & Protection
  hadSex        Boolean @default(false)
  contraception String[] @default([]) // types used
  sexNotes      String?

  // Medications & Health
  medications   String[] @default([]) // medication names
  healthNotes   String?

  // Attachments (optional)
  attachments   String[] @default([]) // S3 URLs

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PeriodCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}

model Pregnancy {
  id                String    @id @default(cuid())
  userId            String    @unique
  lmpDate           DateTime? // Last Menstrual Period
  dueDate           DateTime?
  doctorNotes       String?   @db.Text // Encrypted field
  weekCache         Int?
  isActive          Boolean   @default(true)
  anonymousMode     Boolean   @default(false)
  trimester         Int? // 1, 2, or 3
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kickCounts           KickCount[]
  contractions         Contraction[]
  appointments         PregnancyAppointment[]
  medications          PregnancyMedication[]
  birthPlan            BirthPlan?
  hospitalBagItems     HospitalBagItem[]
  pregnancyNotes       PregnancyNote[]

  @@index([userId])
}

model KickCount {
  id          String   @id @default(cuid())
  pregnancyId String
  sessionDate DateTime
  kickCount   Int
  durationMin Int // Duration in minutes
  notes       String?
  createdAt   DateTime @default(now())

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId, sessionDate])
}

model Contraction {
  id          String   @id @default(cuid())
  pregnancyId String
  startTime   DateTime
  endTime     DateTime
  durationSec Int // Duration in seconds
  intensity   Int? // Optional 1-10 scale
  notes       String?
  createdAt   DateTime @default(now())

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId, startTime])
}

model PregnancyAppointment {
  id            String   @id @default(cuid())
  pregnancyId   String
  appointmentAt DateTime
  clinic        String?
  doctorName    String?
  notes         String?  @db.Text
  vitalsJson    Json? // BP, weight, glucose, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId, appointmentAt])
}

model PregnancyMedication {
  id            String   @id @default(cuid())
  pregnancyId   String
  name          String
  dosage        String?
  frequency     String?
  safetyRating  String? // A, B, C, D, X or custom
  notes         String?  @db.Text
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId])
}

model BirthPlan {
  id              String   @id @default(cuid())
  pregnancyId     String   @unique
  contentJson     Json     @db.JsonB // Structured birth plan data
  lastExportedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
}

model HospitalBagItem {
  id          String   @id @default(cuid())
  pregnancyId String
  category    String // parent, partner, baby
  itemName    String
  isPacked    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId, category])
}

model PregnancyNote {
  id          String   @id @default(cuid())
  pregnancyId String
  title       String?
  content     String   @db.Text
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId, createdAt])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  amountMl  Int
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Reminders & Notifications
// ────────────────────────────────────────────────────────────────────────────

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  type        ReminderType
  payloadJson Json
  nextRunAt   DateTime
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextRunAt])
}

// ────────────────────────────────────────────────────────────────────────────
// AI Chat & Memory
// ────────────────────────────────────────────────────────────────────────────

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  title      String    @default("New Conversation")
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, createdAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  tokens         Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id           String      @id @default(cuid())
  userId       String
  scope        MemoryScope
  key          String
  valueJson    Json // Encrypted field for sensitive data
  tags         String[]    @default([])
  accessCount  Int         @default(0)
  lastAccessed DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([userId, scope])
}

// ────────────────────────────────────────────────────────────────────────────
// Subscriptions & Quotas
// ────────────────────────────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(free)
  status    SubscriptionStatus @default(active)
  renewsAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageQuota {
  id         String   @id @default(cuid())
  userId     String   @unique
  monthKey   String // Format: YYYY-MM
  aiRequests Int      @default(0)
  limit      Int      @default(100)
  resetsAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([userId, monthKey])
}

// ────────────────────────────────────────────────────────────────────────────
// Admin & Configuration
// ────────────────────────────────────────────────────────────────────────────

model ModelPolicy {
  id               String           @id @default(cuid())
  plan             SubscriptionPlan
  provider         AIProvider
  modelName        String
  temperature      Float            @default(0.7)
  maxTokens        Int              @default(1024)
  toolsEnabledJson Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([plan, provider])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entity       String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model FeatureFlag {
  key       String   @id
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Home Screen Personalization
// ────────────────────────────────────────────────────────────────────────────

model UserHomePreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  dismissedCards   Json     @default("{}") // { cardId: dismissedUntil timestamp }
  pinnedCards      String[] @default([]) // ordered list of pinned card IDs
  visiblePills     String[] @default([]) // ordered list of visible pill IDs for Zone B
  streakStartDate  DateTime? // when current water streak started
  streakCount      Int      @default(0) // current streak days
  longestStreak    Int      @default(0) // longest streak achieved
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Educational content feed for Zone D
model EducationalArticle {
  id          String   @id @default(cuid())
  titleTr     String
  titleEn     String?
  contentTr   String   @db.Text
  contentEn   String?  @db.Text
  category    String // menstrual_health, hydration, sleep, exercise, mindfulness
  tags        String[] @default([])
  imageUrl    String?
  priority    Int      @default(0) // higher = shown first
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, publishedAt])
  @@index([isActive, priority])
}

// ────────────────────────────────────────────────────────────────────────────
// Wellness Tracking (Steps, Meditation, Sleep)
// ────────────────────────────────────────────────────────────────────────────

model DailySteps {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // Date only (normalized to start of day UTC)
  count     Int      // Total steps for the day
  source    String   @default("manual") // manual, apple_health, google_fit
  syncedAt  DateTime @default(now())
  isManual  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model MeditationSession {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // Date only (normalized to start of day UTC)
  durationMin Int      // Duration in minutes
  type        String   @default("breath") // breath, guided, custom
  source      String   @default("manual") // manual, apple_health, google_fit
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SleepLog {
  id          String   @id @default(cuid())
  userId      String
  sleepDate   DateTime // Date of the night (normalized to start of day UTC)
  durationMin Int      // Total sleep duration in minutes
  quality     String?  // good, medium, poor (optional)
  source      String   @default("manual") // manual, apple_health, google_fit
  isManual    Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sleepDate])
  @@index([userId, sleepDate])
}

// Wellness tile preferences and targets
model WellnessPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  stepsGoal          Int      @default(7000)
  meditationGoalMin  Int      @default(10)
  sleepGoalHours     Float    @default(7.0)
  tilesEnabled       Json     @default("{\"steps\":true,\"meditation\":true,\"sleep\":true,\"water\":true}") // Feature flags per tile
  notificationsJson  Json     @default("{}") // Per-tile notification settings
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
